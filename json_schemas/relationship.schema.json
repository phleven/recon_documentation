{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benefitsiq.local/contracts/smartdev/v2/relationship.schema.json",
  "title": "SmartDev Relationship JSON Contract - Final",
  "description": "Relationship contract after final review decisions. Employee unique ID is the employee lookup key; relatedPersonUniqueId identifies the related/non-employee person.",
  "type": "object",
  "additionalProperties": false,
  "x-contractStage": "domain-json-record-before-kafka-envelope",
  "x-reviewDecisionsApplied": [
    "Use employeeUniqueId as the employee lookup field.",
    "Use relatedPersonUniqueId as the new related person's unique ID.",
    "Do not use employee demographic fields as related person demographics.",
    "Do not rely only on NonEmployee Tax ID Number as the related person key.",
    "Relationship code uses Data Files Reference Table codes.",
    "NonEmployee Tax ID is optional for SmartDev and can be raw or encrypted by client configuration.",
    "Validated against Data Files: employerCode and related person contact collections are represented in the contract."
  ],
  "required": [
    "productModule",
    "orgId",
    "sourceSystem",
    "employeeUniqueId",
    "relatedPersonUniqueId",
    "relationshipCode",
    "relatedPerson",
    "employerCode"
  ],
  "properties": {
    "productModule": {
      "$ref": "common-definitions.schema.json#/$defs/productModule"
    },
    "orgId": {
      "$ref": "common-definitions.schema.json#/$defs/orgId"
    },
    "clientId": {
      "$ref": "common-definitions.schema.json#/$defs/clientId"
    },
    "sourceSystem": {
      "$ref": "common-definitions.schema.json#/$defs/sourceSystem"
    },
    "loadId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80,
      "description": "Optional load/cycle identifier for lineage and error investigation."
    },
    "sourceFileName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255,
      "description": "Optional file name for lineage. File naming should include file type and timestamp."
    },
    "employeeUniqueId": {
      "$ref": "common-definitions.schema.json#/$defs/uniqueId",
      "description": "Employee/subscriber lookup key."
    },
    "employeeSourceAssignmentId": {
      "$ref": "common-definitions.schema.json#/$defs/sourceAssignmentId",
      "description": "Optional matching context only. Not required when employeeUniqueId is authoritative."
    },
    "relatedPersonUniqueId": {
      "$ref": "common-definitions.schema.json#/$defs/uniqueId",
      "description": "Unique ID for the related/non-employee person. Must not be the employee unique ID."
    },
    "relationshipCode": {
      "$ref": "common-definitions.schema.json#/$defs/relationshipCode"
    },
    "relatedPerson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstName",
        "lastName",
        "dateOfBirth",
        "personType"
      ],
      "properties": {
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "middleName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "nonEmployeeTaxIdNumber": {
          "$ref": "common-definitions.schema.json#/$defs/taxIdValue"
        },
        "taxIdValueFormat": {
          "$ref": "common-definitions.schema.json#/$defs/taxIdValueFormat"
        },
        "nonEmployeeTaxIdType": {
          "$ref": "common-definitions.schema.json#/$defs/taxIdType"
        },
        "dateOfBirth": {
          "$ref": "common-definitions.schema.json#/$defs/dateIso"
        },
        "dateOfDeath": {
          "$ref": "common-definitions.schema.json#/$defs/nullableDateIso"
        },
        "personType": {
          "const": "NONEMPLOYEE"
        },
        "nonEmployeeUsCitizen": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "gender": {
          "$ref": "common-definitions.schema.json#/$defs/gender"
        },
        "title": {
          "$ref": "common-definitions.schema.json#/$defs/titleCode"
        },
        "suffix": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2
        },
        "languagePreference": {
          "$ref": "common-definitions.schema.json#/$defs/languageCode"
        },
        "primaryAddressType": {
          "$ref": "common-definitions.schema.json#/$defs/addressType"
        },
        "primaryPhoneType": {
          "$ref": "common-definitions.schema.json#/$defs/phoneType"
        },
        "primaryEmailType": {
          "$ref": "common-definitions.schema.json#/$defs/emailType"
        },
        "preferredCommunication": {
          "$ref": "common-definitions.schema.json#/$defs/commPreference"
        },
        "addresses": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "common-definitions.schema.json#/$defs/address"
          },
          "description": "Optional related person address collection from Data Files."
        },
        "emails": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "common-definitions.schema.json#/$defs/emailContact"
          },
          "description": "Optional related person email collection from Data Files."
        },
        "phones": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "common-definitions.schema.json#/$defs/phoneContact"
          },
          "description": "Optional related person phone collection from Data Files."
        }
      }
    },
    "employerCode": {
      "$ref": "common-definitions.schema.json#/$defs/employerCode"
    }
  }
}
