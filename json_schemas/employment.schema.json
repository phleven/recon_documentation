{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benefitsiq.local/contracts/smartdev/v2/employment.schema.json",
  "title": "SmartDev Employment JSON Contract - Final",
  "description": "Employment contract after final review decisions. Several fields are optional for SmartDev and should not block contract finalization.",
  "type": "object",
  "additionalProperties": false,
  "x-contractStage": "domain-json-record-before-kafka-envelope",
  "x-reviewDecisionsApplied": [
    "Use employeeUniqueId instead of repeating employee demographic lookup fields.",
    "Update Type is expected to be CURRENT for SmartDev non-conversion loads.",
    "Employment Status is optional for SmartDev.",
    "Action and Reason are optional for SmartDev.",
    "Full Time Percentage is not required for SmartDev.",
    "Department / Division and Business Unit are optional for SmartDev and come from organization setup.",
    "PSHB fields are optional for SmartDev.",
    "Validated against Data Files: employerCode is required; optional Employment fields remain nullable."
  ],
  "required": [
    "productModule",
    "orgId",
    "sourceSystem",
    "employeeUniqueId",
    "effectiveDate",
    "employerCode"
  ],
  "properties": {
    "productModule": {
      "$ref": "common-definitions.schema.json#/$defs/productModule"
    },
    "orgId": {
      "$ref": "common-definitions.schema.json#/$defs/orgId"
    },
    "clientId": {
      "$ref": "common-definitions.schema.json#/$defs/clientId"
    },
    "sourceSystem": {
      "$ref": "common-definitions.schema.json#/$defs/sourceSystem"
    },
    "loadId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80,
      "description": "Optional load/cycle identifier for lineage and error investigation."
    },
    "sourceFileName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255,
      "description": "Optional file name for lineage. File naming should include file type and timestamp."
    },
    "employeeUniqueId": {
      "$ref": "common-definitions.schema.json#/$defs/uniqueId"
    },
    "sourceAssignmentId": {
      "$ref": "common-definitions.schema.json#/$defs/sourceAssignmentId"
    },
    "effectiveDate": {
      "$ref": "common-definitions.schema.json#/$defs/dateIso"
    },
    "updateType": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "CURRENT",
        null
      ],
      "default": "CURRENT",
      "description": "Expected value for SmartDev non-conversion loads. PRIOR is not expected unless a conversion-specific configuration is approved."
    },
    "status": {
      "$ref": "common-definitions.schema.json#/$defs/employmentStatus"
    },
    "action": {
      "$ref": "common-definitions.schema.json#/$defs/actionCode"
    },
    "reason": {
      "$ref": "common-definitions.schema.json#/$defs/reasonCode"
    },
    "jobType": {
      "$ref": "common-definitions.schema.json#/$defs/jobType"
    },
    "fullTimePercentage": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Optional for SmartDev. If provided, use numeric percent scale where 100 means 100 percent."
    },
    "positionStatus": {
      "$ref": "common-definitions.schema.json#/$defs/positionStatus"
    },
    "departmentCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8,
      "description": "Optional for SmartDev. Final review direction: value comes from organization code after organizations are set up."
    },
    "businessUnitCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8,
      "description": "Optional for SmartDev. Final review direction: value comes from organization setup."
    },
    "workLocation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20
    },
    "region": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20
    },
    "exempt": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "unionAffiliation": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "unionCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20
    },
    "positionNumber": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20
    },
    "jobClassification": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20
    },
    "payPlan": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8
    },
    "grade": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8
    },
    "payLevel": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8
    },
    "salaryRateCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8
    },
    "dutyStationStateCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8
    },
    "dutyStationCountyCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8
    },
    "dutyStationCityCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8
    },
    "specialEmployeeCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10
    },
    "expatriate": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "officer": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ficaCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4
    },
    "tenure": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4
    },
    "pshbEligibilityStatus": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1,
      "description": "Optional for SmartDev. PSHB health-field discussion remains separate."
    },
    "pshbEligibilityEffectiveDate": {
      "$ref": "common-definitions.schema.json#/$defs/nullableDateIso"
    },
    "payrollOfficeId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8,
      "description": "Optional for SmartDev."
    },
    "pshbRateScheduleCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2,
      "description": "Optional for SmartDev."
    },
    "pshbRateCategoryCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1,
      "description": "Optional for SmartDev."
    },
    "employerCode": {
      "$ref": "common-definitions.schema.json#/$defs/employerCode"
    },
    "exempt2": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8
    },
    "exempt3": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8
    },
    "terminationNoaCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3
    },
    "rsActionCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 3
    },
    "owcpRollType": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1
    },
    "owcpTerminationIndicator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "owcpTransferInIndicator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "transferInEffectiveDate": {
      "$ref": "common-definitions.schema.json#/$defs/nullableDateIso"
    },
    "owcpReinstatementIndicator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "reinstatementDate": {
      "$ref": "common-definitions.schema.json#/$defs/nullableDateIso"
    },
    "reEmployedAnnuitantIndicator": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "preTaxHealthBenefitIndicator": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}
