{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benefitsiq.local/contracts/smartdev/v2/validation-rule-config.schema.json",
  "title": "SmartDev Validation Rule Configuration - Final",
  "description": "Configuration structure for enabling/disabling validation rules by product module, client, and domain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productModule",
    "clientId",
    "domains"
  ],
  "properties": {
    "productModule": {
      "$ref": "common-definitions.schema.json#/$defs/productModule"
    },
    "clientId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "configurationVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "taxIdPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredForSmartDev",
        "acceptedFormats",
        "encryptionTargetSprint"
      ],
      "properties": {
        "requiredForSmartDev": {
          "type": "boolean",
          "const": false
        },
        "acceptedFormats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "RAW",
              "HMAC",
              "ENCRYPTED"
            ]
          }
        },
        "keyManagementOwner": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "keyStoreName": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "encryptionTargetSprint": {
          "type": "string",
          "description": "Final review direction: non-encrypted now, encryption targeted for 26.10 Sprint 4."
        }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person",
        "employment",
        "relationship"
      ],
      "properties": {
        "person": {
          "$ref": "#/$defs/domainRuleConfig"
        },
        "employment": {
          "$ref": "#/$defs/domainRuleConfig"
        },
        "relationship": {
          "$ref": "#/$defs/domainRuleConfig"
        }
      }
    }
  },
  "$defs": {
    "domainRuleConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabledRules",
        "disabledRules",
        "maxRecordsPerEvent"
      ],
      "properties": {
        "enabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disabledRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxRecordsPerEvent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  }
}
