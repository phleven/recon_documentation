{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benefitsiq.local/contracts/smartdev/v2/domain-event-envelope.schema.json",
  "title": "SmartDev Kafka Domain Event Envelope - Final",
  "description": "Generic Kafka event envelope for file/API/stream convergence. Records can contain 1..N domain records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "eventTimestamp",
    "productModule",
    "orgId",
    "sourceSystem",
    "domain",
    "records"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "eventType": {
      "type": "string",
      "enum": [
        "person.create",
        "person.update",
        "employment.create",
        "employment.update",
        "relationship.create",
        "relationship.update"
      ]
    },
    "eventVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "eventTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "productModule": {
      "$ref": "common-definitions.schema.json#/$defs/productModule"
    },
    "orgId": {
      "$ref": "common-definitions.schema.json#/$defs/orgId"
    },
    "clientId": {
      "$ref": "common-definitions.schema.json#/$defs/clientId"
    },
    "sourceSystem": {
      "$ref": "common-definitions.schema.json#/$defs/sourceSystem"
    },
    "domain": {
      "type": "string",
      "enum": [
        "person",
        "employment",
        "relationship"
      ]
    },
    "loadId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "sourceFileName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "description": "Payload size is configurable per client. MVP supports enable/disable and configured batch size, not user-authored rules.",
      "items": {
        "type": "object"
      }
    }
  }
}
