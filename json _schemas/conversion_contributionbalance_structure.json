{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/conversionContributionBalance.schema.json",
  "title": "Conversion-ContributionBalance Domain",
  "description": "JSON Schema for the Conversion-ContributionBalance domain",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "recordType": {
          "description": "Record type indicator",
          "type": "string"
        },
        "fileName": {
          "description": "Source file name",
          "type": "string"
        },
        "fileType": {
          "description": "File type identifier",
          "type": "string"
        },
        "sourceId": {
          "description": "Source system or vendor identifier",
          "type": "string"
        },
        "createDate": {
          "description": "File creation date",
          "type": "string"
        },
        "createTimestamp": {
          "description": "File creation time",
          "type": "string"
        },
        "periodBeginDate": {
          "description": "Beginning date of the reporting period",
          "type": "string"
        },
        "periodEndDate": {
          "description": "Ending date of the reporting period",
          "type": "string"
        },
        "recordCount": {
          "description": "Number of conversionContributionBalance records in the file",
          "type": "integer"
        }
      },
      "required": [
        "recordType",
        "fileName",
        "fileType",
        "sourceId",
        "createDate",
        "createTimestamp",
        "periodBeginDate",
        "periodEndDate",
        "recordCount"
      ]
    },
    "ConversionContributionBalance": {
      "type": "object",
      "properties": {
        "conversionContributionBalance": {
          "type": "object",
          "properties": {
            "recordType": {
              "description": "Detail Record",
              "type": "string",
              "maxLength": 1
            },
            "uniqueIdentifier": {
              "description": "Primary participant identifier; this could be the SSN or Employee Id to be determined by the project team.",
              "type": "string",
              "maxLength": 12
            },
            "sourceAssignmentId": {
              "description": "An assignment key that identifies the job in case of employee having the same employee id across multiple job under the same employer",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 12
            },
            "employerCode": {
              "description": "Unique employer code that would be generated by BenefitsIQ; this code to be used by employer when they provide these files",
              "type": "string",
              "maxLength": 4
            },
            "lastName": {
              "description": "This is member's (employee) last name to help with identifying employee's record; this does not get loaded;",
              "type": "string",
              "maxLength": 100
            },
            "firstName": {
              "description": "This is member's (employee) fisrt name to help with identifying employee's record; this does not get loaded;",
              "type": "string",
              "maxLength": 50
            },
            "planID": {
              "description": "Pension plan identifier",
              "type": "string",
              "maxLength": 4
            },
            "subplanID": {
              "description": "Division, class, bargaining unit, or subgroup",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4
            },
            "conversionAsOfDate": {
              "description": "Snapshot date for balances",
              "type": "string",
              "maxLength": 10
            },
            "contributionType": {
              "description": "REQUIRED, VOLUNTARY, PICKUP, REDEPOSIT, BUYBACK, SERVICE PURCHASE",
              "type": "string",
              "maxLength": 2
            },
            "contributionStatus": {
              "description": "ACTIVE, SUSPENDED, REFUNDED, CLOSED",
              "type": "string",
              "maxLength": 3
            },
            "employeeContributionPrincipal": {
              "description": "Total employee contribution principal balance",
              "type": "number"
            },
            "interestBalance": {
              "description": "Interest credited as of conversion date",
              "type": [
                "number",
                "null"
              ]
            },
            "totalContributionBalance": {
              "description": "Principal plus interest",
              "type": "number"
            },
            "taxBasis": {
              "description": "AFTER_TAX, PRETAX, PICKUP, MIXED",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2
            },
            "employerPickupFlag": {
              "description": "Indicates employer-paid pickup treatment",
              "type": [
                "boolean",
                "null"
              ]
            },
            "interestCreditedThroughDate": {
              "description": "Date through which interest is included",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 10
            },
            "interestMethodCode": {
              "description": "STATUTORY, FIXED, VARIABLE, NONE",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2
            },
            "interestRate": {
              "description": "If a single rate applies and target stores it",
              "type": [
                "number",
                "null"
              ]
            },
            "contributionStartDate": {
              "description": "Start of contributory participation",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 10
            },
            "contributionEndDate": {
              "description": "Populated if contributions stopped",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 10
            },
            "lastContributionDate": {
              "description": "Most recent contribution posted",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 10
            },
            "refundStatus": {
              "description": "NONE, PARTIAL, FULL",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2
            },
            "refundedPrincipalAmount": {
              "description": "Total refunded employee principal",
              "type": [
                "number",
                "null"
              ]
            },
            "refundedInterestAmount": {
              "description": "Interest paid out on refund",
              "type": [
                "number",
                "null"
              ]
            },
            "lastRefundDate": {
              "description": "Most recent refund date",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 10
            },
            "redepositPrincipalAmount": {
              "description": "Amount repaid after prior refund",
              "type": [
                "number",
                "null"
              ]
            },
            "redepositInterestAmount": {
              "description": "Interest tied to redeposit",
              "type": [
                "number",
                "null"
              ]
            },
            "lastRedepositDate": {
              "description": "Most recent redeposit date",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 10
            },
            "purchasedServiceAmount": {
              "description": "Contributions tied to service purchase / buyback",
              "type": [
                "number",
                "null"
              ]
            },
            "arrearsAmount": {
              "description": "Missed required employee contributions",
              "type": [
                "number",
                "null"
              ]
            },
            "relatedServiceCredit": {
              "description": "If contribution balance ties to service restoration",
              "type": [
                "number",
                "null"
              ]
            },
            "dataSourceSystem": {
              "description": "Source system for reconciliation",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 20
            },
            "legacyRecordID": {
              "description": "Legacy row identifier",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 10
            }
          },
          "required": [
            "recordType",
            "uniqueIdentifier",
            "employerCode",
            "lastName",
            "firstName",
            "planID",
            "conversionAsOfDate",
            "contributionType",
            "contributionStatus",
            "employeeContributionPrincipal",
            "totalContributionBalance"
          ]
        }
      },
      "required": [
        "conversionContributionBalance"
      ]
    }
  },
  "required": [
    "manifest",
    "ConversionContributionBalance"
  ]
}
