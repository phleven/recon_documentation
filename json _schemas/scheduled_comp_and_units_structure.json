{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/scheduledCompAndUnits.schema.json",
  "title": "Scheduled Comp and Units Domain",
  "description": "JSON Schema for the Scheduled Comp and Units domain",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "recordType": {
          "description": "Record type indicator",
          "type": "string"
        },
        "fileName": {
          "description": "Source file name",
          "type": "string"
        },
        "fileType": {
          "description": "File type identifier",
          "type": "string"
        },
        "sourceId": {
          "description": "Source system or vendor identifier",
          "type": "string"
        },
        "createDate": {
          "description": "File creation date",
          "type": "string"
        },
        "createTimestamp": {
          "description": "File creation time",
          "type": "string"
        },
        "periodBeginDate": {
          "description": "Beginning date of the reporting period",
          "type": "string"
        },
        "periodEndDate": {
          "description": "Ending date of the reporting period",
          "type": "string"
        },
        "recordCount": {
          "description": "Number of scheduledCompAndUnit records in the file",
          "type": "integer"
        }
      },
      "required": [
        "recordType",
        "fileName",
        "fileType",
        "sourceId",
        "createDate",
        "createTimestamp",
        "periodBeginDate",
        "periodEndDate",
        "recordCount"
      ]
    },
    "ScheduledCompAndUnits": {
      "type": "object",
      "properties": {
        "scheduledCompAndUnit": {
          "type": "object",
          "properties": {
            "recordType": {
              "description": "Detail Record",
              "type": "string",
              "maxLength": 1
            },
            "uniqueIdentifier": {
              "description": "Primary participant identifier; this could be the SSN or Employee Id to be determined by the project team.",
              "type": "string",
              "maxLength": 12
            },
            "sourceAssignmentId": {
              "description": "An assignment key that identifies the job in case of employee having the same employee id across multiple job under the same employer",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 12
            },
            "employerCode": {
              "description": "Unique employer code that would be generated by BenefitsIQ; this code to be used by employer when they provide these files",
              "type": "string",
              "maxLength": 4
            },
            "lastName": {
              "description": "This is member's (employee) last name to help with identifying employee's record; this does not get loaded;",
              "type": "string",
              "maxLength": 100
            },
            "firstName": {
              "description": "This is member's (employee) fisrt name to help with identifying employee's record; this does not get loaded;",
              "type": "string",
              "maxLength": 50
            },
            "effectiveDate": {
              "description": "Represents the as of date for any action taken on scheduled comp and units worked.",
              "type": "string",
              "maxLength": 10
            },
            "rateOfPay": {
              "description": "Rate of Pay",
              "type": "number"
            },
            "payRateType": {
              "description": "Represents the pay amount associated with the pay type received for the given pay period.\nSee \"Reference Table\" sheet",
              "type": "string",
              "maxLength": 2
            },
            "currency": {
              "description": "Represents the currency associated with the pay amount.",
              "type": "string",
              "maxLength": 2
            },
            "rateOfPayFrequency": {
              "description": "This value must correspond to the employer’s pay schedule and represents the frequency with which wages and contributions will be reported.\n\nFor available options, see Frequency section on \"Emp Valid Values\" sheet.",
              "type": "string",
              "maxLength": 2
            },
            "scheduledTypeOfUnitsToWork": {
              "description": "See \"Reference Table\" sheet",
              "type": "string",
              "maxLength": 2
            },
            "scheduledNumberOfUnitsToWork": {
              "description": "Scheduled # of Units to Work",
              "type": "integer"
            },
            "unitsToWorkFrequency": {
              "description": "See \"Reference Table\" sheet",
              "type": "string",
              "maxLength": 2
            },
            "scheduledFullTimeUnits": {
              "description": "Scheduled Full Time Units",
              "type": [
                "integer",
                "null"
              ]
            },
            "scheduledFullTimeUnitsFrequency": {
              "description": "See \"Reference Table\" sheet",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2
            },
            "unitsAnnuallyContractedToWork": {
              "description": "Units Annually Contracted to Work",
              "type": [
                "integer",
                "null"
              ]
            },
            "numberOfMonthsPaid": {
              "description": "Number of Months Paid",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "recordType",
            "uniqueIdentifier",
            "employerCode",
            "lastName",
            "firstName",
            "effectiveDate",
            "rateOfPay",
            "payRateType",
            "currency",
            "rateOfPayFrequency",
            "scheduledTypeOfUnitsToWork",
            "scheduledNumberOfUnitsToWork",
            "unitsToWorkFrequency"
          ]
        }
      },
      "required": [
        "scheduledCompAndUnit"
      ]
    }
  },
  "required": [
    "manifest",
    "ScheduledCompAndUnits"
  ]
}
