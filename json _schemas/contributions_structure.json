{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/contributions.schema.json",
  "title": "Contributions Domain",
  "description": "JSON Schema for the Contributions domain",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "recordType": {
          "description": "Record type indicator",
          "type": "string"
        },
        "fileName": {
          "description": "Source file name",
          "type": "string"
        },
        "fileType": {
          "description": "File type identifier",
          "type": "string"
        },
        "sourceId": {
          "description": "Source system or vendor identifier",
          "type": "string"
        },
        "createDate": {
          "description": "File creation date",
          "type": "string"
        },
        "createTimestamp": {
          "description": "File creation time",
          "type": "string"
        },
        "periodBeginDate": {
          "description": "Beginning date of the reporting period",
          "type": "string"
        },
        "periodEndDate": {
          "description": "Ending date of the reporting period",
          "type": "string"
        },
        "recordCount": {
          "description": "Number of contribution records in the file",
          "type": "integer"
        }
      },
      "required": [
        "recordType",
        "fileName",
        "fileType",
        "sourceId",
        "createDate",
        "createTimestamp",
        "periodBeginDate",
        "periodEndDate",
        "recordCount"
      ]
    },
    "Contributions": {
      "type": "object",
      "properties": {
        "contribution": {
          "type": "object",
          "properties": {
            "recordType": {
              "description": "Detail Record",
              "type": "string",
              "maxLength": 1
            },
            "uniqueIdentifier": {
              "description": "Primary participant identifier",
              "type": "string",
              "maxLength": 12
            },
            "sourceAssignmentId": {
              "description": "An assignment key that identifies the job in case of employee having the same employee id across multiple job under the same employer",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 12
            },
            "employerCode": {
              "description": "Unique employer code that would be generated by BenefitsIQ; this code to be used by employer when they provide these files",
              "type": "string",
              "maxLength": 4
            },
            "lastName": {
              "description": "This is member's (employee) last name to help with identifying employee's record; this does not get loaded;",
              "type": "string",
              "maxLength": 100
            },
            "firstName": {
              "description": "This is member's (employee) fisrt name to help with identifying employee's record; this does not get loaded;",
              "type": "string",
              "maxLength": 50
            },
            "planID": {
              "description": "Pension plan identifier",
              "type": "string",
              "maxLength": 4
            },
            "periodBeginDate": {
              "description": "Period Begin Date",
              "type": "string",
              "maxLength": 10
            },
            "periodEndDate": {
              "description": "Period End Date",
              "type": "string",
              "maxLength": 10
            },
            "contributionDate": {
              "description": "Contribution Date",
              "type": "string",
              "maxLength": 10
            },
            "type": {
              "description": "Refer to 'Ret Valid Values' sheet.",
              "type": "string",
              "maxLength": 2
            },
            "participationGroupCode": {
              "description": "Participation Group Code",
              "type": "string",
              "maxLength": 4
            },
            "status": {
              "description": "Refer to 'Ret Valid Values' sheet.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2
            },
            "rate": {
              "description": "Rate",
              "type": [
                "number",
                "null"
              ]
            },
            "preTaxEmployeeContribution": {
              "description": "Pre-Tax Employee Contribution",
              "type": "number"
            },
            "postTaxEmployeeContribution": {
              "description": "Post-Tax Employee Contribution",
              "type": [
                "number",
                "null"
              ]
            },
            "interestAmount": {
              "description": "Interest Amount",
              "type": [
                "number",
                "null"
              ]
            },
            "wages": {
              "description": "Wages",
              "type": [
                "number",
                "null"
              ]
            },
            "employerContribution": {
              "description": "Employer Contribution",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "recordType",
            "uniqueIdentifier",
            "employerCode",
            "lastName",
            "firstName",
            "planID",
            "periodBeginDate",
            "periodEndDate",
            "contributionDate",
            "type",
            "participationGroupCode",
            "preTaxEmployeeContribution"
          ]
        }
      },
      "required": [
        "contribution"
      ]
    }
  },
  "required": [
    "manifest",
    "Contributions"
  ]
}
